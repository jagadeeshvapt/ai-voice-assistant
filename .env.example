# JARVIS AI VOICE ASSISTANT CONFIG
# Copy this file to .env and fill values

# --- CORE ---
JARVIS_NAME=JARVIS
USER_NAME=Sir
WAKE_WORDS=jarvis,hey jarvis,ok jarvis
VOICE_RATE=180
VOICE_GENDER=male
LANGUAGE=en-in
TEXT_MODE=false
DEBUG=false

# --- AI BRAIN ---
# Optional - will use intelligent local fallback if not set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional for better online brains
ANTHROPIC_API_KEY=

# --- WEATHER ---
OPENWEATHER_API_KEY=
# Get free key from https://openweathermap.org/api
DEFAULT_CITY=London

# --- EMAIL (for send email skill) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- TTS ---
# Options: pyttsx3, edge, auto
TTS_ENGINE=auto
EDGE_VOICE=en-US-GuyNeural
# Use en-GB-RyanNeural for Jarvis-like British male
# Use en-US-JennyNeural for female

# --- STT ---
# Options: google, whisper, auto
STT_ENGINE=google

# --- VISION ---
ENABLE_VISION=false
CAMERA_INDEX=0
